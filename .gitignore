# ---------------------------------------------------------------------------
# DATA IS NEVER COMMITTED.
#
# Rico is distributed under a University of Illinois research-use agreement
# that does not permit redistribution, and its screenshots may contain
# third-party copyrighted material. Committing data/raw/ would breach that
# agreement. AndroidControl is 46.5 GB. Neither belongs in git.
# ---------------------------------------------------------------------------
data/
!data/**/.gitkeep

# Environment
.env
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Run artifacts
outputs/logs/*
outputs/checkpoints/*
!outputs/**/.gitkeep
# Regenerated by phase0_setup/02_init_project.py on every run; it records
# this machine's absolute paths, so it is not committed.
outputs/manuscript/project_manifest.json

# Analysis outputs: figures and reports ARE committed (they are the paper's
# evidence and should be diffable), but large intermediate files are not.
*.parquet
*.tar.gz
*.zip
!phase5_analysis/**/outputs/**

# OS and editor noise
.DS_Store
._*
Thumbs.db
.vscode/
.idea/
