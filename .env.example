# Copy this file to .env and edit if you need to. Every value is optional:
# without a .env the project uses ./data and ./outputs inside the repo.
#
#   cp .env.example .env

# Where the raw datasets live. Rico is 6 GB and AndroidControl is 46.5 GB,
# so point this at a disk with at least 80 GB free if you download everything.
A11YDEBT_DATA_DIR=./data

# Where logs, checkpoints and manuscript numbers are written.
A11YDEBT_OUTPUT_DIR=./outputs

# Set to 1 to disable ANSI colour in console output (useful in CI).
# NO_COLOR=1
